[node name="Guard" type="CharacterBody3D" parent="People" unique_id=1749611435 instance=ExtResource("95_ejlhc")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3.4, 0, 34.4)
script = ExtResource("96_vv1h2")
lines = PackedStringArray("Bienvenido a Brumaclara, forastero. Mantén el arma envainada dentro de las murallas.", "Si buscas trabajo, sube por la plaza hasta la sede del Faro: siempre necesitan manos.")

[node name="Carter" type="CharacterBody3D" parent="People" unique_id=1127548869 instance=ExtResource("97_1s0cw")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -24, 0, 20.4)
script = ExtResource("96_vv1h2")
lines = PackedStringArray("Algo atacó mi carro en el camino del oeste. Venía de la maleza... y brillaba.", "Hasta que alguien despeje ese camino, ninguna caravana sale del almacén.")

[node name="Mara" type="CharacterBody3D" parent="People" unique_id=75604752 instance=ExtResource("98_bndsd")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 2.6, 5.3939586, -28.2)
script = ExtResource("96_vv1h2")
lines = PackedStringArray("Soy Mara Venn. Aquí repartimos los contratos del Faro.", "Hay un encargo sencillo: averiguar qué pasa en las afueras, al oeste. Paga poco, pero incluye cama.")

