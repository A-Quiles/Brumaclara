; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Proyecto Brumaclara (nombre provisional)"
config/description="RPG de acción de fantasía en pixel art (juego final en desarrollo). Empieza en el pueblo de Brumaclara."
run/main_scene="res://scenes/ui/character_creator.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Progress="*res://scripts/systems/progress.gd"
EditMode="*res://scripts/tools/edit_mode/edit_mode.gd"
Transition="*res://scripts/systems/transition.gd"
DayNight="*res://scripts/systems/day_night.gd"
Quests="*res://scripts/systems/quests.gd"

[brumaclara]

; developer edit mode (M): false switches it off; exported release builds never have it
modo_edicion=true

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

